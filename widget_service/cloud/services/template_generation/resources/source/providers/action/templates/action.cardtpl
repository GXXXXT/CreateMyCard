#Template PillAction@1(props: { actionId: string, label: string, icon?: asset })
data = {
}

Stack({
  "width": "matchParent",
  "height": 36,
  "borderRadius": 18,
  "backgroundColor": $theme('actionStyle.backgroundColor'),
  "alignContent": "center",
  "onClick": EventAction(props.actionId)
},
  Row({
    "justifyContent": "center",
    "alignItems": "center"
  },
    #if props.icon
      Image(props.icon, {
        "width": 20,
        "height": 20,
        "objectFit": "contain",
        "fillColor": $theme('actionStyle.contentColor')
      })
    #endif
    Text(props.label, {
      "fontSize": 14,
      "fontWeight": 500,
      "fontColor": $theme('actionStyle.contentColor'),
      "maxLines": 1,
      "textOverflow": "ellipsis"
    })
  )
)
#End

#Template CompactAction@1(props: { actionId: string, label: string, icon: asset, prominent?: boolean, showFavoriteSubtitle?: boolean })
data = {
}

Stack({
  "width": "matchParent",
  "height": "matchParent",
  "borderRadius": $theme('supportContentStyle.borderRadius'),
  "backgroundColor": $theme('supportContentStyle.backgroundColor'),
  "alignContent": "center",
  "onClick": EventAction(props.actionId)
},
#if props.prominent
  Row({
    "width": "matchParent",
    "height": "matchParent",
    "padding": {"left": 8, "top": 0, "right": 8, "bottom": 0},
    "justifyContent": "spaceBetween",
    "alignItems": "center"
  },
    Text(props.label, {
      "layoutWeight": 1,
      "height": 21,
      "fontSize": 16,
      "fontWeight": 700,
      "fontColor": $theme('primaryColor'),
      "maxLines": 1,
      "textOverflow": "ellipsis",
      "textAlign": "start"
    }),
    Image(props.icon, {
      "width": 24,
      "height": 24,
      "objectFit": "contain",
      "flexShrink": 0
    })
  )
#else
  Row({
    "width": "matchParent",
    "height": "matchParent",
    "padding": {"left": 12, "top": 0, "right": 16, "bottom": 0},
    "justifyContent": "spaceBetween",
    "alignItems": "center"
  },
    #if props.showFavoriteSubtitle
      Column({
        "layoutWeight": 1,
        "height": 36,
        "margin": {"top": 1},
        "itemMargin": 2,
        "justifyContent": "center",
        "alignItems": "start"
      },
        Text(props.label, {
          "width": "matchParent",
          "height": 20,
          "fontSize": 14,
          "fontWeight": 700,
          "fontColor": $theme('primaryColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "textAlign": "start"
        }),
        Text("播放我的收藏", {
          "width": "matchParent",
          "height": 14,
          "fontSize": 10,
          "fontWeight": 400,
          "fontColor": $theme('supportContentColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "textAlign": "start"
        })
      ),
    #else
      Text(props.label, {
        "layoutWeight": 1,
        "height": 19,
        "fontSize": 14,
        "fontWeight": 700,
        "fontColor": $theme('primaryColor'),
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "textAlign": "start"
      }),
    #endif
    Image(props.icon, {
      "width": 24,
      "height": 24,
      "objectFit": "contain",
      "flexShrink": 0
    })
  )
#endif
)
#End

