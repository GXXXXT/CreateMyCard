#Template PillAction@1(props: { actionId: string, label: string, icon?: asset })
data = {
}

Stack({
  "width": "matchParent",
  "height": 36,
  "borderRadius": 18,
  "backgroundColor": $theme('actionStyle.backgroundColor'),
  "alignContent": "center",
  "onClick": EventAction(props.actionId)
},
  Row({
    "justifyContent": "center",
    "alignItems": "center"
  },
    #if props.icon
      Image(props.icon, {
        "width": 20,
        "height": 20,
        "objectFit": "contain",
        "fillColor": $theme('actionStyle.contentColor')
      })
    #endif
    Text(props.label, {
      "fontSize": 14,
      "fontWeight": 500,
      "fontColor": $theme('actionStyle.contentColor'),
      "maxLines": 1,
      "textOverflow": "ellipsis"
    })
  )
)
#End

#Template CompactAction@1(props: { actionId: string, label: string, icon: asset })
data = {
}

Stack({
  "width": "matchParent",
  "height": "matchParent",
  "borderRadius": $theme('supportContentStyle.borderRadius'),
  "backgroundColor": $theme('supportContentStyle.backgroundColor'),
  "alignContent": "center",
  "onClick": EventAction(props.actionId)
},
  Row({
    "width": "matchParent",
    "height": "matchParent",
    "padding": {"left": 12, "top": 0, "right": 16, "bottom": 0},
    "justifyContent": "spaceBetween",
    "alignItems": "center"
  },
    Text(props.label, {
      "layoutWeight": 1,
      "height": 19,
      "fontSize": 14,
      "fontWeight": 700,
      "fontColor": $theme('primaryColor'),
      "maxLines": 1,
      "textOverflow": "ellipsis",
      "textAlign": "start"
    }),
    Image(props.icon, {
      "width": 24,
      "height": 24,
      "objectFit": "contain",
      "flexShrink": 0
    })
  )
)
#End

#Template IconAction@1(props: { actionId: string, icon: asset })
